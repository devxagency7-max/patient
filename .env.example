# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Backend host WITHOUT trailing slash and WITHOUT the /api/v1 segment.
# Production MUST be https:// (iOS ATS / Android cleartext block http).
# Example: https://api.tamenny.com
API_HOST=https://your-api-host

# Google Places API key (restrict it to your app + Places API in the console).
GOOGLE_PLACES_API_KEY=your-google-places-key
